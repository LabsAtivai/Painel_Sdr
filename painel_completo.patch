+"""Rotina diária: um botão atualiza Gmail + Agenda + Confirmações e a tela já mostra o relatório pronto."""
+import threading
+from datetime import date, datetime, timedelta
+
+from fastapi import APIRouter, Depends, Request
+from fastapi.responses import RedirectResponse
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.database import get_db
+from app.models.schema import SDR, Agenda, EmailEnviado, ExecutionLog
+from app.services import sync_service
+from app.services.confirmacao_match import Confirmacoes
+from app.templating import templates
+
+router = APIRouter()
+
+# só o que o relatório usa (o Streak, que é mais lento, fica de fora)
+MODULOS_ROTINA = ("GMAIL", "AGENDA", "CONFIRMACOES")
+
+
+def dia_seguinte(hoje: date) -> date:
+    """Próximo dia útil: de sexta/sábado/domingo o 'dia seguinte' é segunda."""
+    d = hoje + timedelta(days=1)
+    while d.weekday() >= 5:
+        d += timedelta(days=1)
+    return d
+
+
+def dia_enviados(hoje: date) -> date:
+    """Dia dos e-mails enviados no relatório: o dia; na segunda, 3 dias atrás (sexta)."""
+    return hoje - timedelta(days=3) if hoje.weekday() == 0 else hoje
+
+
+def rotulo(nome: str | None) -> str:
+    """Nome do SDR como na planilha: Julia@ativa.ai."""
+    nome = (nome or "—").strip()
+    return nome if "@" in nome or nome == "—" else f"{nome}@ativa.ai"
+
+
+def _estado_coleta(db: Session, hoje: date) -> list[dict]:
+    """Última execução de cada módulo da rotina + se está ok (sucesso e feita hoje)."""
+    out = []
+    for m in MODULOS_ROTINA:
+        log = db.scalar(select(ExecutionLog).where(ExecutionLog.modulo == m).order_by(ExecutionLog.id.desc()).limit(1))
+        ok = bool(log and log.status == "SUCCESS" and log.data_execucao.date() == hoje)
+        out.append({"modulo": m, "log": log, "ok": ok, "falhou": bool(log and log.status != "SUCCESS")})
+    return out
+
+
+@router.get("/rotina")
+def rotina(request: Request, dia: date | None = None, db: Session = Depends(get_db)):
+    hoje = date.today()
+    alvo = dia_seguinte(hoje)
+    ini, fim = datetime.combine(alvo, datetime.min.time()), datetime.combine(alvo + timedelta(days=1), datetime.min.time())
+
+    # e-mails enviados: um dia só (padrão: o dia; segunda -> sexta). A sincronização mantém hoje + 3 dias anteriores.
+    dias = [hoje - timedelta(days=i) for i in range(3, -1, -1)]
+    dia_env = dia if dia in dias else dia_enviados(hoje)
+    qtd = dict(db.execute(select(EmailEnviado.sdr_id, EmailEnviado.quantidade).where(EmailEnviado.data_registro == dia_env)).all())
+    enviados = [(rotulo(s.nome), qtd.get(s.id)) for s in db.scalars(select(SDR).where(SDR.ativo.is_(True)).order_by(SDR.nome))]
+    tot_enviados = sum(q or 0 for _, q in enviados)
+
+    # reuniões do dia seguinte, agrupadas por SDR (propostas primeiro, depois qualificação), com Sim/Não
+    eventos = db.execute(
+        select(Agenda, SDR.nome).join(SDR, SDR.id == Agenda.sdr_id, isouter=True)
+        .where(Agenda.data_inicio >= ini, Agenda.data_inicio < fim)).all()
+    conf = Confirmacoes(db, ini, fim)
+    grupos: dict[str, list] = {}
+    for a, nome in eventos:
+        titulo = a.titulo_reuniao or ""
+        eh_proposta = "proposta" in titulo.lower()
+        grupos.setdefault(rotulo(nome), []).append(
+            {"titulo": titulo, "proposta": eh_proposta, "conf": conf.status(titulo, a.email_convidado, a.data_inicio)})
+    for itens in grupos.values():
+        itens.sort(key=lambda i: (not i["proposta"], i["titulo"].lower()))
+    grupos = dict(sorted(grupos.items()))
+    totais = [(sdr, len(it), sum(i["proposta"] for i in it), sum(not i["proposta"] for i in it)) for sdr, it in grupos.items()]
+    tot_geral = (sum(t[1] for t in totais), sum(t[2] for t in totais), sum(t[3] for t in totais))
+
+    return templates.TemplateResponse(request, "rotina.html", {
+        "page": "rotina", "hoje": hoje, "alvo": alvo, "dias": dias, "dia_env": dia_env,
+        "enviados": enviados, "tot_enviados": tot_enviados, "grupos": grupos, "totais": totais, "tot_geral": tot_geral,
+        "sem_cobertura": any(i["conf"] is None for it in grupos.values() for i in it),
+        "coleta": _estado_coleta(db, hoje), "rodando": sync_service.is_running(),
+    })
+
+
+@router.post("/rotina/atualizar")
+def atualizar():
+    """Dispara a coleta em segundo plano; a página recarrega sozinha quando termina (script do base.html)."""
+    if not sync_service.is_running():
+        threading.Thread(target=sync_service.run_sync, kwargs={"modulos": MODULOS_ROTINA, "trigger": "rotina"}, daemon=True).start()
+    return RedirectResponse("/rotina", status_code=303)
