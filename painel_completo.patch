+{% extends "base.html" %}
+{% block content %}
+<style>
+  .rel { display: grid; grid-template-columns: minmax(230px, .8fr) minmax(430px, 2fr) minmax(360px, 1fr); gap: 18px; align-items: start; background: #fff; padding: 14px; border: 1px solid var(--line); border-radius: var(--r); }
+  @media (max-width: 1100px) { .rel { grid-template-columns: 1fr; } }
+  .rel table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
+  .rel th, .rel td { padding: 5px 8px; border-bottom: 1px solid #d9dde1; text-align: left; }
+  .rel .titulo { background: #ff9900; color: #000; font-weight: 800; text-align: center; padding: 7px 8px; letter-spacing: .02em; }
+  .rel .titulo small { display: block; font-weight: 600; font-size: 11.5px; opacity: .8; }
+  .rel thead th { background: #bfbfbf; color: #000; font-weight: 600; }
+  .rel thead th.n { background: #000; color: #fff; }
+  .rel td.n, .rel th.n { text-align: right; font-variant-numeric: tabular-nums; }
+  .rel tr.sdr td { background: #eee; font-weight: 700; }
+  .rel tr.sub td { background: #bfbfbf; font-weight: 700; }
+  .rel tr.tot td { background: #bfbfbf; font-weight: 800; border-top: 2px solid #000; }
+  .rel td.sim, .rel td.nao, .rel td.nd { text-align: center; font-weight: 600; width: 92px; }
+  .rel td.sim { background: #3ddc5a; color: #000; }
+  .rel td.nao { background: #ff3b30; color: #fff; }
+  .rel td.nd { color: #888; }
+  .rel .tit { background: #eee; }
+  .rel thead th.box { background: #fff; color: #000; border: 1px solid #000; text-align: center; }
+</style>
+
+<div class="head">
+  <h1>Rotina diária</h1>
+  <form method="post" action="/rotina/atualizar">
+    <button class="btn btn-primary {{ 'spin' if rodando }}" {{ 'disabled' if rodando }}>
+      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 0 0-14.9-3M4 5v3.5h3.5"/><path d="M4 13a8 8 0 0 0 14.9 3M20 19v-3.5h-3.5"/></svg>
+      <span>{{ 'Atualizando…' if rodando else 'Atualizar tudo e gerar relatório' }}</span>
+    </button>
+  </form>
+</div>
+
+{# estado honesto da coleta: o relatório só é confiável se os 3 módulos rodaram hoje sem erro #}
+{% if coleta|rejectattr('ok')|list %}
+<div class="panel" style="margin-bottom:16px; border-color:#e6b8b3; background:var(--late-soft)">
+  <div style="padding:10px 14px">
+    <b>Os dados podem estar desatualizados.</b> Clique em “Atualizar tudo e gerar relatório”.
+    {% for c in coleta if not c.ok %}
+      <div class="mute">{{ c.modulo }}: {% if not c.log %}nunca executado{% elif c.falhou %}falhou em {{ c.log.data_execucao.strftime('%d/%m %H:%M') }} — veja a aba Logs{% else %}última coleta em {{ c.log.data_execucao.strftime('%d/%m %H:%M') }}{% endif %}</div>
+    {% endfor %}
+  </div>
+</div>
+{% else %}
+<p class="mute" style="margin:0 0 12px">Dados atualizados hoje às {{ (coleta|map(attribute='log.data_execucao')|max).strftime('%H:%M') }}.</p>
+{% endif %}
+{% if sem_cobertura %}<p class="mute" style="margin:0 0 12px">“—” na confirmação: ainda não há e-mails do SalesOps coletados para essa data.</p>{% endif %}
+
+<div class="head" style="margin-bottom:10px">
+  <p class="mute">E-mails enviados do dia:</p>
+  <nav class="seg" aria-label="Dia dos e-mails enviados">
+    {% for d in dias %}<a href="/rotina?dia={{ d.isoformat() }}" {% if d == dia_env %}aria-current="true"{% endif %}>{{ d|weekday }} {{ d.strftime('%d/%m') }}{{ ' · hoje' if d == hoje }}</a>{% endfor %}
+  </nav>
